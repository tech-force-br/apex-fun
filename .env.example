# Copy to apps/web/.env.local and apps/runner/.env as needed.
# Never commit real keys.

# --- apps/web ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RUNNER_URL=http://127.0.0.1:8787
RUNNER_SECRET=

# --- apps/runner ---
PORT=8787
RUNNER_SECRET=
# Path to aer.exe once downloaded. Leave empty to use `aer` on PATH.
AER_BIN=
